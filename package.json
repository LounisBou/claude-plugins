{
  "name": "claude-plugins",
  "private": true,
  "description": "LounisBou's Claude Code plugins, one repository, one catalogue.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings --test --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/*.spec.ts' --test-coverage-exclude='plugins/*/core/**' --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 'scripts/**/*.test.ts' 'packages/*/src/**/*.test.ts' 'plugins/*/skills/*/scripts/**/*.spec.ts'",
    "marketplace": "node --experimental-strip-types --no-warnings scripts/marketplace.ts",
    "release": "node --experimental-strip-types --no-warnings scripts/release.ts",
    "version-bump": "node --experimental-strip-types --no-warnings scripts/version-bump.ts",
    "plugin-matrix": "node --experimental-strip-types --no-warnings scripts/plugin-matrix.ts",
    "prompts": "node --experimental-strip-types --no-warnings scripts/prompts.ts",
    "core": "node --experimental-strip-types --no-warnings scripts/core.ts",
    "deps": "node --experimental-strip-types --no-warnings scripts/deps.ts",
    "permissions": "node --experimental-strip-types --no-warnings scripts/permissions.ts",
    "rules": "node --experimental-strip-types --no-warnings scripts/rules.ts",
    "context": "node --experimental-strip-types --no-warnings scripts/context.ts",
    "outcome": "node --experimental-strip-types --no-warnings scripts/outcome.ts"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "typescript": "5.8.3"
  }
}
