{
  "$comment": "What the strict check covers today. A plugin's TypeScript joins `include` the day it passes; it never leaves (docs/conventions.md, « Ratchets »).",
  "extends": "./tsconfig.base.json",
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "plugins/cloudflare/hooks/register.ts",
    "plugins/cloudflare/types/*.d.ts",
    "plugins/implement/hooks/core.ts",
    "plugins/implement/hooks/register.ts",
    "plugins/implement/hooks/review.ts",
    "plugins/implement/types/*.d.ts",
    "plugins/norms/hooks/*.ts",
    "plugins/norms/types/*.d.ts",
    "plugins/pr-review/hooks/*.ts",
    "plugins/statusbar/hooks/*.ts",
    "plugins/orchestrator/types/*.d.ts",
    "plugins/drift/skills/*/scripts/**/*.ts",
    "plugins/learning/skills/*/scripts/**/*.ts",
    "plugins/learning/hooks/register.ts",
    "plugins/orchestrator/skills/*/scripts/**/*.ts",
    "plugins/orchestrator/hooks/models-guard.ts",
    "plugins/orchestrator/hooks/module-log.ts",
    "plugins/orchestrator/hooks/module-io.ts",
    "plugins/orchestrator/hooks/session-name.ts",
    "plugins/orchestrator/hooks/short-names.ts",
    "plugins/orchestrator/hooks/gauge-core.ts",
    "plugins/orchestrator/hooks/move.ts",
    "plugins/orchestrator/hooks/gauge.ts",
    "plugins/orchestrator/hooks/host.ts",
    "plugins/orchestrator/hooks/audit-events.ts",
    "plugins/telemetry/skills/*/scripts/**/*.ts",
    "plugins/telemetry/hooks/collect.ts",
    "plugins/telemetry/hooks/register.ts",
    "plugins/telemetry/hooks/schema.ts"
  ]
}
