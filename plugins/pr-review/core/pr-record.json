{
  "$comment": "Generated from packages/core/src by `npm run core`: edit the source, never this copy.",
  "version": 1,
  "kinds": [
    "review",
    "norms",
    "e2e"
  ],
  "results": [
    "pass",
    "fail",
    "waived",
    "not-applicable",
    "accepted"
  ],
  "waivable": "e2e",
  "not_applicable": "e2e",
  "acceptance": {
    "result": "accepted",
    "kind": "review",
    "answers": "fail",
    "plugin": "orchestrator",
    "tool": "mcp__orchestrator__accept"
  },
  "producers": {
    "review": {
      "plugin": "pr-review",
      "tool": "its auto-fix-loop"
    },
    "norms": {
      "plugin": "norms",
      "tool": "/norms:check"
    }
  },
  "open": "e2e",
  "detail_max": 500,
  "patterns": {
    "head": "^[0-9a-fA-F]{40}$",
    "repo_part": "^[A-Za-z0-9_.-]+$",
    "producer": "^[a-z0-9-]+$",
    "waiver_date": "\\b\\d{4}-\\d{2}-\\d{2}\\b"
  }
}
