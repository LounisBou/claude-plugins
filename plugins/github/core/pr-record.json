{
  "$comment": "Generated from packages/core/src by `npm run core`: edit the source, never this copy.",
  "version": 1,
  "kinds": [
    "review",
    "norms",
    "e2e",
    "tests"
  ],
  "results": [
    "pass",
    "fail",
    "waived",
    "not-applicable",
    "accepted"
  ],
  "waivable": [
    "e2e",
    "norms"
  ],
  "not_applicable": "e2e",
  "acceptance": {
    "result": "accepted",
    "kind": "review",
    "plugin": "orchestrator",
    "tool": "mcp__orchestrator__review"
  },
  "producers": {
    "review": [
      {
        "plugin": "pr-review",
        "tool": "its auto-fix-loop"
      },
      {
        "plugin": "orchestrator",
        "tool": "mcp__orchestrator__review"
      }
    ],
    "norms": [
      {
        "plugin": "norms",
        "tool": "/norms:check"
      }
    ]
  },
  "open": "e2e",
  "scripted": {
    "kind": "tests",
    "plugin": "github",
    "tool": "mcp__github__light_ci",
    "producer": "light-ci",
    "results": [
      "pass",
      "fail"
    ]
  },
  "detail_max": 500,
  "patterns": {
    "head": "^[0-9a-fA-F]{40}$",
    "repo_part": "^[A-Za-z0-9_.-]+$",
    "producer": "^[a-z0-9-]+$"
  }
}
